# .env.example — Copia este archivo como .env y completa los valores

# ── Firebase ──────────────────────────────────────────────────────────────────
# Obtén estos valores en: Firebase Console > Project Settings > Web App
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ── Google Sheets ─────────────────────────────────────────────────────────────
# URL pública de la hoja CONFIG en formato CSV
# Pasos: Archivo > Compartir > Publicar en la web > CSV > Copiar URL
VITE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/gviz/tq?tqx=out:csv&sheet=CONFIG

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Número de WhatsApp de 🔥 Inversiones Multipower (sin + ni espacios)
# Ejemplo: 584120000000
VITE_WA_NUMBER=584120000000

